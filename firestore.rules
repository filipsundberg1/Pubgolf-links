rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins: Filip och Adam. Ändras bara här i reglerna.
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
        'Xg358wyGpsNui9FLyOE4IL4xKqH2', // Filip Sundberg
        '2qeuBiMqAVUTfWbL6JH5TGRw9BA3'  // Adam Larsson
      ];
    }

    // Avstängda spelare kan inte skapa banor, rundor eller gå med i rundor.
    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    // Klunkar på hål 10–18 är valfria (banor kan ha 1–18 hål)
    function optSip(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 0 && data[key] <= 25);
    }

    function extraSipsValid(data) {
      return optSip(data, 'sipsHole10') && optSip(data, 'sipsHole11') && optSip(data, 'sipsHole12') &&
        optSip(data, 'sipsHole13') && optSip(data, 'sipsHole14') && optSip(data, 'sipsHole15') &&
        optSip(data, 'sipsHole16') && optSip(data, 'sipsHole17') && optSip(data, 'sipsHole18');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Reusable PlayerProfile (/profiles/{userId})
    function isValidProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'appId', 'displayName', 'nickname', 'country', 'homePub',
        'signatureDrink', 'favoriteClub', 'handicap', 'bio', 'avatarSeed', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'appId', 'displayName', 'nickname', 'country', 'homePub',
        'signatureDrink', 'favoriteClub', 'handicap', 'bio', 'avatarSeed', 'playerCode', 'wins', 'updatedAt'
      ]) &&
      (!('wins' in data) || (data.wins is int && data.wins >= 0 && data.wins <= 9999)) &&
      (!('playerCode' in data) || (data.playerCode is string && data.playerCode.matches('^[A-Z]{2}[0-9]{4}$'))) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == userId &&
      data.uid == request.auth.uid &&
      data.appId is string && data.appId.size() >= 1 && data.appId.size() <= 64 &&
      data.appId == 'december-links' &&
      data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60 &&
      data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 50 &&
      data.country is string && data.country.size() >= 2 && data.country.size() <= 50 &&
      data.homePub is string && data.homePub.size() >= 2 && data.homePub.size() <= 80 &&
      data.signatureDrink is string && data.signatureDrink.size() >= 2 && data.signatureDrink.size() <= 80 &&
      data.favoriteClub is string && data.favoriteClub.size() >= 2 && data.favoriteClub.size() <= 80 &&
      data.handicap is string && data.handicap.size() >= 1 && data.handicap.size() <= 20 &&
      data.bio is string && data.bio.size() >= 2 && data.bio.size() <= 320 &&
      data.avatarSeed is string && data.avatarSeed.size() >= 1 && data.avatarSeed.size() <= 32 &&
      data.updatedAt == request.time;
    }

    // Validation Blueprint: Course / Round (/courses/{courseId})
    function isValidCourse(data, courseId) {
      return data.keys().hasAll([
        'courseId', 'appId', 'inviteCode', 'title', 'subtitle', 'city',
        'eventDate', 'ownerId', 'ownerName', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'courseId', 'appId', 'inviteCode', 'title', 'subtitle', 'city',
        'eventDate', 'ownerId', 'ownerName', 'gameMode', 'isPublic', 'holeCount', 'updatedAt'
      ]) &&
      (!('isPublic' in data) || data.isPublic is bool) &&
      (!('holeCount' in data) || (data.holeCount is int && data.holeCount >= 1 && data.holeCount <= 18)) &&
      data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 128 &&
      data.courseId == courseId &&
      data.appId is string && data.appId.size() >= 1 && data.appId.size() <= 64 &&
      data.appId == 'december-links' &&
      data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 16 &&
      data.inviteCode.matches('^[A-Z0-9\\-]+$') &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
      data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 140 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
      data.eventDate is string && data.eventDate.size() >= 2 && data.eventDate.size() <= 40 &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80 &&
      (!('gameMode' in data) || (
        data.gameMode is string &&
        data.gameMode.size() >= 1 &&
        data.gameMode.size() <= 20 &&
        data.gameMode in ['single', 'brutal']
      )) &&
      data.updatedAt == request.time;
    }

    // Validation Blueprint: Hole (/courses/{courseId}/holes/{holeId})
    function isValidHole(data, courseId) {
      return data.keys().hasAll([
        'holeNumber', 'courseId', 'ownerId', 'pubName', 'pubAddress',
        'drinkName', 'drinkType', 'volumeCl', 'par', 'lengthMeters',
        'shape', 'hazardTitle', 'hazardRule', 'caddieTip', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'holeNumber', 'courseId', 'ownerId', 'pubName', 'pubAddress',
        'drinkName', 'drinkType', 'volumeCl', 'par', 'lengthMeters',
        'shape', 'hazardTitle', 'hazardRule', 'caddieTip', 'updatedAt'
      ]) &&
      data.holeNumber is int && data.holeNumber >= 1 && data.holeNumber <= 18 &&
      data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 128 &&
      data.courseId == courseId &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.pubName is string && data.pubName.size() >= 2 && data.pubName.size() <= 80 &&
      data.pubAddress is string && data.pubAddress.size() >= 2 && data.pubAddress.size() <= 120 &&
      data.drinkName is string && data.drinkName.size() >= 2 && data.drinkName.size() <= 80 &&
      data.drinkType is string && data.drinkType.size() <= 20 &&
      data.drinkType in ['stout', 'lager', 'ipa', 'cider', 'cocktail', 'shot', 'glögg', 'alkoholfritt'] &&
      data.volumeCl is int && data.volumeCl >= 2 && data.volumeCl <= 100 &&
      data.par is int && data.par >= 1 && data.par <= 6 &&
      data.lengthMeters is int && data.lengthMeters >= 50 && data.lengthMeters <= 650 &&
      data.shape is string && data.shape.size() <= 20 &&
      data.shape in ['straight', 'dogleg-left', 'dogleg-right', 'island-green', 'double-dogleg'] &&
      data.hazardTitle is string && data.hazardTitle.size() >= 2 && data.hazardTitle.size() <= 80 &&
      data.hazardRule is string && data.hazardRule.size() >= 2 && data.hazardRule.size() <= 180 &&
      data.caddieTip is string && data.caddieTip.size() >= 2 && data.caddieTip.size() <= 200 &&
      data.updatedAt == request.time;
    }

    // Validation Blueprint: RoundParticipant (/courses/{courseId}/participants/{playerId})
    function isValidParticipant(data, courseId, playerId) {
      return data.keys().hasAll([
        'uid', 'courseId', 'displayName', 'nickname', 'country', 'homePub',
        'signatureDrink', 'favoriteClub', 'handicap', 'bio', 'avatarSeed',
        'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
        'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
        'totalSips', 'totalToPar', 'thruHoles', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'courseId', 'displayName', 'nickname', 'country', 'homePub',
        'signatureDrink', 'favoriteClub', 'handicap', 'bio', 'avatarSeed',
        'teamId', 'teamName',
        'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
        'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
        'totalSips', 'totalToPar', 'thruHoles', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == playerId &&
      data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 128 &&
      data.courseId == courseId &&
      data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60 &&
      data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 50 &&
      data.country is string && data.country.size() >= 2 && data.country.size() <= 50 &&
      data.homePub is string && data.homePub.size() >= 2 && data.homePub.size() <= 80 &&
      data.signatureDrink is string && data.signatureDrink.size() >= 2 && data.signatureDrink.size() <= 80 &&
      data.favoriteClub is string && data.favoriteClub.size() >= 2 && data.favoriteClub.size() <= 80 &&
      data.handicap is string && data.handicap.size() >= 1 && data.handicap.size() <= 20 &&
      data.bio is string && data.bio.size() >= 2 && data.bio.size() <= 320 &&
      data.avatarSeed is string && data.avatarSeed.size() >= 1 && data.avatarSeed.size() <= 32 &&
      (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 64)) &&
      (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 60)) &&
      data.sipsHole1 is int && data.sipsHole1 >= 0 && data.sipsHole1 <= 25 &&
      data.sipsHole2 is int && data.sipsHole2 >= 0 && data.sipsHole2 <= 25 &&
      data.sipsHole3 is int && data.sipsHole3 >= 0 && data.sipsHole3 <= 25 &&
      data.sipsHole4 is int && data.sipsHole4 >= 0 && data.sipsHole4 <= 25 &&
      data.sipsHole5 is int && data.sipsHole5 >= 0 && data.sipsHole5 <= 25 &&
      data.sipsHole6 is int && data.sipsHole6 >= 0 && data.sipsHole6 <= 25 &&
      data.sipsHole7 is int && data.sipsHole7 >= 0 && data.sipsHole7 <= 25 &&
      data.sipsHole8 is int && data.sipsHole8 >= 0 && data.sipsHole8 <= 25 &&
      data.sipsHole9 is int && data.sipsHole9 >= 0 && data.sipsHole9 <= 25 &&
      data.totalSips is int && data.totalSips >= 0 && data.totalSips <= 225 &&
      data.totalToPar is int && data.totalToPar >= -45 && data.totalToPar <= 180 &&
      data.thruHoles is int && data.thruHoles >= 0 && data.thruHoles <= 9 &&
      data.updatedAt == request.time;
    }

    // Validation Blueprint: Round (/rounds/{roundId}) – a played instance of a course.
    // The document id IS the invite code, so only people who know the code can find the round.
    function isValidRound(data, roundId) {
      return data.keys().hasAll([
        'roundId', 'appId', 'courseId', 'courseTitle', 'city', 'eventDate',
        'ownerId', 'ownerName', 'gameMode', 'memberIds', 'locked', 'status', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'roundId', 'appId', 'courseId', 'courseTitle', 'city', 'eventDate',
        'ownerId', 'ownerName', 'gameMode', 'memberIds', 'locked', 'status', 'customHoles', 'invitedIds', 'updatedAt'
      ]) &&
      data.roundId == roundId &&
      roundId.matches('^PG-[A-Z0-9]{4,8}$') &&
      data.appId == 'december-links' &&
      data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 128 &&
      data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 80 &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
      data.eventDate is string && data.eventDate.size() >= 2 && data.eventDate.size() <= 40 &&
      data.ownerId is string && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80 &&
      data.gameMode in ['single', 'brutal'] &&
      data.memberIds is list && data.memberIds.size() <= 40 &&
      data.locked is bool &&
      data.status in ['lobby', 'active', 'finished', 'deleted'] &&
      (!('customHoles' in data) || (data.customHoles is list && data.customHoles.size() >= 1 && data.customHoles.size() <= 18)) &&
      (!('invitedIds' in data) || (data.invitedIds is list && data.invitedIds.size() <= 40)) &&
      data.updatedAt == request.time;
    }

    // Validation Blueprint: RoundParticipant (/rounds/{roundId}/participants/{playerId})
    function isValidRoundParticipant(data, roundId, playerId) {
      return data.keys().hasAll([
        'uid', 'roundId', 'displayName', 'nickname', 'avatarSeed', 'handicap',
        'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
        'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
        'totalSips', 'totalToPar', 'thruHoles', 'countsForHcp', 'keptResult', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'roundId', 'displayName', 'nickname', 'avatarSeed', 'handicap', 'playerCode',
        'teamId', 'teamName',
        'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
        'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
        'sipsHole10', 'sipsHole11', 'sipsHole12', 'sipsHole13', 'sipsHole14',
        'sipsHole15', 'sipsHole16', 'sipsHole17', 'sipsHole18',
        'totalSips', 'totalToPar', 'thruHoles', 'countsForHcp', 'keptResult', 'penalties', 'updatedAt'
      ]) &&
      data.uid == playerId &&
      data.roundId == roundId &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.nickname is string && data.nickname.size() <= 50 &&
      data.avatarSeed is string && data.avatarSeed.size() >= 1 && data.avatarSeed.size() <= 32 &&
      data.handicap is string && data.handicap.size() <= 20 &&
      (!('playerCode' in data) || (data.playerCode is string && data.playerCode.size() <= 12)) &&
      (!('teamId' in data) || (data.teamId is string && data.teamId.size() <= 64)) &&
      (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 60)) &&
      data.sipsHole1 is int && data.sipsHole1 >= 0 && data.sipsHole1 <= 25 &&
      data.sipsHole2 is int && data.sipsHole2 >= 0 && data.sipsHole2 <= 25 &&
      data.sipsHole3 is int && data.sipsHole3 >= 0 && data.sipsHole3 <= 25 &&
      data.sipsHole4 is int && data.sipsHole4 >= 0 && data.sipsHole4 <= 25 &&
      data.sipsHole5 is int && data.sipsHole5 >= 0 && data.sipsHole5 <= 25 &&
      data.sipsHole6 is int && data.sipsHole6 >= 0 && data.sipsHole6 <= 25 &&
      data.sipsHole7 is int && data.sipsHole7 >= 0 && data.sipsHole7 <= 25 &&
      data.sipsHole8 is int && data.sipsHole8 >= 0 && data.sipsHole8 <= 25 &&
      data.sipsHole9 is int && data.sipsHole9 >= 0 && data.sipsHole9 <= 25 &&
      extraSipsValid(data) &&
      // Plikt och bonus: lista med {hole, type}, max 100
      (!('penalties' in data) || (data.penalties is list && data.penalties.size() <= 100)) &&
      data.totalSips is int && data.totalSips >= 0 && data.totalSips <= 450 &&
      data.totalToPar is int && data.totalToPar >= -300 && data.totalToPar <= 700 &&
      data.thruHoles is int && data.thruHoles >= 0 && data.thruHoles <= 18 &&
      data.countsForHcp is bool &&
      data.keptResult is bool &&
      data.updatedAt == request.time;
    }

    // Collection: /rounds/{roundId}
    match /rounds/{roundId} {
      function roundUnchangedCore() {
        return incoming().roundId == existing().roundId &&
          incoming().appId == existing().appId &&
          incoming().ownerId == existing().ownerId &&
          incoming().courseId == existing().courseId;
      }

      // Anyone signed in who knows the code (= document id) may look the round up.
      allow get: if isSignedIn() && isValidId(roundId);
      // Listing only returns rounds you are a member of – or invited to.
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in resource.data.get('invitedIds', []) ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        !isBanned() &&
        isValidRound(incoming(), roundId) &&
        incoming().ownerId == request.auth.uid &&
        request.auth.uid in incoming().memberIds &&
        incoming().status in ['lobby', 'active'];

      allow update: if isVerifiedUser() &&
        isValidRound(incoming(), roundId) &&
        roundUnchangedCore() &&
        (
          // Owner: lock/unlock, add/remove players, change date/game mode, delete for everyone
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'courseTitle', 'city', 'eventDate', 'ownerName', 'gameMode',
              'memberIds', 'locked', 'status', 'customHoles', 'invitedIds', 'updatedAt'
            ])
          ) ||
          // Accept an invite: move yourself from invitedIds to memberIds (works even when locked)
          (
            !isBanned() &&
            existing().status != 'deleted' &&
            request.auth.uid in existing().get('invitedIds', []) &&
            !(request.auth.uid in existing().memberIds) &&
            incoming().memberIds == existing().memberIds.concat([request.auth.uid]) &&
            incoming().get('invitedIds', []) == existing().get('invitedIds', []).removeAll([request.auth.uid]) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'invitedIds', 'updatedAt'])
          ) ||
          // Decline an invite: only remove yourself from invitedIds
          (
            request.auth.uid in existing().get('invitedIds', []) &&
            incoming().get('invitedIds', []) == existing().get('invitedIds', []).removeAll([request.auth.uid]) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['invitedIds', 'updatedAt'])
          ) ||
          // Join with the code: only while in the lobby or active and unlocked, only adding yourself
          (
            !isBanned() &&
            existing().status in ['lobby', 'active'] &&
            existing().locked == false &&
            !(request.auth.uid in existing().memberIds) &&
            incoming().memberIds == existing().memberIds.concat([request.auth.uid]) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          ) ||
          // Leave the round (or remove it from your history): only removing yourself
          (
            request.auth.uid in existing().memberIds &&
            incoming().memberIds == existing().memberIds.removeAll([request.auth.uid]) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
          )
        );

      allow delete: if (isVerifiedUser() && existing().ownerId == request.auth.uid) || isAdmin();

      // Subcollection: /rounds/{roundId}/messages/{messageId} – lobbysnack och tomater
      match /messages/{messageId} {
        function chatRound() {
          return get(/databases/$(database)/documents/rounds/$(roundId)).data;
        }

        allow get, list: if isSignedIn() && (isAdmin() || request.auth.uid in chatRound().memberIds);

        allow create: if isVerifiedUser() &&
          !isBanned() &&
          request.auth.uid in chatRound().memberIds &&
          chatRound().status != 'deleted' &&
          incoming().keys().hasOnly(['uid', 'type', 'text', 'targetUid', 'createdAt']) &&
          incoming().keys().hasAll(['uid', 'type', 'text', 'createdAt']) &&
          incoming().uid == request.auth.uid &&
          incoming().type in ['chat', 'tomato'] &&
          incoming().text is string &&
          incoming().text.size() <= 280 &&
          (incoming().type != 'chat' || incoming().text.size() >= 1) &&
          (incoming().type != 'tomato' || (incoming().get('targetUid', '') in chatRound().memberIds && incoming().targetUid != request.auth.uid)) &&
          (!('targetUid' in incoming()) || isValidId(incoming().targetUid)) &&
          incoming().createdAt == request.time;

        allow update: if false;

        // Egna meddelanden, eller ägaren/admin, kan tas bort
        allow delete: if isSignedIn() &&
          (existing().uid == request.auth.uid || chatRound().ownerId == request.auth.uid || isAdmin());
      }

      // Subcollection: /rounds/{roundId}/participants/{playerId}
      match /participants/{playerId} {
        function roundData() {
          return get(/databases/$(database)/documents/rounds/$(roundId)).data;
        }
        function roundDataAfter() {
          return getAfter(/databases/$(database)/documents/rounds/$(roundId)).data;
        }

        allow get, list: if isSignedIn() && (isAdmin() || request.auth.uid in roundData().memberIds);

        allow create: if isVerifiedUser() &&
          !isBanned() &&
          isValidId(playerId) &&
          isValidRoundParticipant(incoming(), roundId, playerId) &&
          playerId in roundDataAfter().memberIds &&
          (playerId == request.auth.uid || roundDataAfter().ownerId == request.auth.uid);

        allow update: if isVerifiedUser() &&
          isValidRoundParticipant(incoming(), roundId, playerId) &&
          incoming().uid == existing().uid &&
          incoming().roundId == existing().roundId &&
          (
            (
              existing().uid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'nickname', 'avatarSeed', 'handicap', 'playerCode',
                'teamId', 'teamName',
                'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
                'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
                'sipsHole10', 'sipsHole11', 'sipsHole12', 'sipsHole13', 'sipsHole14',
                'sipsHole15', 'sipsHole16', 'sipsHole17', 'sipsHole18',
                'totalSips', 'totalToPar', 'thruHoles', 'countsForHcp', 'keptResult', 'penalties', 'updatedAt'
              ])
            ) ||
            (
              roundData().ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['teamId', 'teamName', 'updatedAt'])
            )
          );

        allow delete: if (isVerifiedUser() &&
          (existing().uid == request.auth.uid || roundData().ownerId == request.auth.uid)) || isAdmin();
      }
    }

    // Collection: /follows/{followerId_targetId} – vänner. Följer båda varandra = vänner.
    match /follows/{followId} {
      allow get, list: if isSignedIn();

      allow create: if isVerifiedUser() &&
        !isBanned() &&
        incoming().keys().hasOnly(['followerId', 'targetId', 'appId', 'dismissed', 'createdAt']) &&
        incoming().keys().hasAll(['followerId', 'targetId', 'appId', 'dismissed', 'createdAt']) &&
        incoming().followerId == request.auth.uid &&
        incoming().targetId is string &&
        isValidId(incoming().targetId) &&
        incoming().targetId != request.auth.uid &&
        followId == incoming().followerId + '_' + incoming().targetId &&
        incoming().appId == 'december-links' &&
        incoming().dismissed == false &&
        incoming().createdAt == request.time;

      // Den som blir följd kan ignorera förfrågan
      allow update: if isVerifiedUser() &&
        existing().targetId == request.auth.uid &&
        incoming().dismissed is bool &&
        incoming().diff(existing()).affectedKeys().hasOnly(['dismissed']);

      // Båda parter kan ta bort (sluta följa / ta bort vän)
      allow delete: if isVerifiedUser() &&
        (existing().followerId == request.auth.uid || existing().targetId == request.auth.uid);
    }

    // Collection: /bans/{userId} – avstängda spelare. Bara admins skriver.
    match /bans/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() &&
        incoming().keys().hasOnly(['uid', 'appId', 'bannedBy', 'createdAt']) &&
        incoming().uid == userId &&
        incoming().appId == 'december-links' &&
        incoming().bannedBy == request.auth.uid &&
        incoming().createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Collection: /profiles/{userId}
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().appId == 'december-links';
      allow list: if isSignedIn() && existing().appId == 'december-links';

      allow create: if isVerifiedUser() &&
        !isBanned() &&
        isValidId(userId) &&
        isValidProfile(incoming(), userId);

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidProfile(incoming(), userId) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().appId == existing().appId &&
        // Spelar-ID sätts en gång och ändras sedan aldrig
        (!('playerCode' in existing()) || incoming().playerCode == existing().playerCode) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'nickname', 'country', 'homePub', 'signatureDrink',
          'favoriteClub', 'handicap', 'bio', 'avatarSeed', 'playerCode', 'wins', 'updatedAt'
        ]);

      allow delete: if isAdmin();
    }

    // Collection: /courses/{courseId}
    match /courses/{courseId} {
      allow get: if isSignedIn() && isValidId(courseId) && existing().appId == 'december-links';
      allow list: if isSignedIn() && existing().appId == 'december-links';

      allow create: if isVerifiedUser() &&
        !isBanned() &&
        isValidId(courseId) &&
        isValidCourse(incoming(), courseId);

      allow update: if isVerifiedUser() &&
        isValidId(courseId) &&
        isValidCourse(incoming(), courseId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().courseId == existing().courseId &&
        incoming().appId == existing().appId &&
        incoming().inviteCode == existing().inviteCode &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'city', 'eventDate', 'ownerName', 'gameMode', 'isPublic', 'holeCount', 'updatedAt'
        ]);

      allow delete: if (isVerifiedUser() &&
        isValidId(courseId) &&
        existing().ownerId == request.auth.uid) || isAdmin();

      // Subcollection: /courses/{courseId}/holes/{holeId}
      match /holes/{holeId} {
        allow get: if isSignedIn() &&
          isValidId(courseId) &&
          isValidId(holeId) &&
          existing().courseId == courseId &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.appId == 'december-links';

        allow list: if isSignedIn() &&
          existing().courseId == courseId;

        allow create: if isVerifiedUser() &&
          isValidId(courseId) &&
          isValidId(holeId) &&
          isValidHole(incoming(), courseId) &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(courseId) &&
          isValidId(holeId) &&
          isValidHole(incoming(), courseId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().courseId == existing().courseId &&
          incoming().holeNumber == existing().holeNumber &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pubName', 'pubAddress', 'drinkName', 'drinkType', 'volumeCl',
            'par', 'lengthMeters', 'shape', 'hazardTitle', 'hazardRule',
            'caddieTip', 'updatedAt'
          ]);

        // Banans skapare kan ta bort hål (när banan kortas eller raderas)
        allow delete: if isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid);
      }

      // Subcollection: /courses/{courseId}/participants/{playerId}
      match /participants/{playerId} {
        allow get: if isSignedIn() &&
          isValidId(courseId) &&
          isValidId(playerId) &&
          existing().courseId == courseId &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.appId == 'december-links';

        allow list: if isSignedIn() &&
          existing().courseId == courseId;

        allow create: if isVerifiedUser() &&
          isValidId(courseId) &&
          isValidId(playerId) &&
          isValidParticipant(incoming(), courseId, playerId) &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.appId == 'december-links' &&
          (
            incoming().uid == request.auth.uid ||
            get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid
          );

        allow update: if isVerifiedUser() &&
          isValidId(courseId) &&
          isValidId(playerId) &&
          isValidParticipant(incoming(), courseId, playerId) &&
          incoming().uid == existing().uid &&
          incoming().courseId == existing().courseId &&
          get(/databases/$(database)/documents/courses/$(courseId)).data.appId == 'december-links' &&
          (
            // Tier 1: Participant Owner updating their own scorecard, profile, or team
            (
              existing().uid == request.auth.uid &&
              (
                // Action 1: Update Scorecard Sips & Team
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'teamId', 'teamName',
                  'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
                  'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
                  'totalSips', 'totalToPar', 'thruHoles', 'updatedAt'
                ]) ||
                // Action 2: Sync PGA Tour Profile, Team & Scorecard
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'nickname', 'country', 'homePub', 'signatureDrink',
                  'favoriteClub', 'handicap', 'bio', 'avatarSeed',
                  'teamId', 'teamName',
                  'sipsHole1', 'sipsHole2', 'sipsHole3', 'sipsHole4', 'sipsHole5',
                  'sipsHole6', 'sipsHole7', 'sipsHole8', 'sipsHole9',
                  'totalSips', 'totalToPar', 'thruHoles', 'updatedAt'
                ])
              )
            ) ||
            // Tier 2: Course Owner (Banarkitekt) assigning 2-player Brutal Ball teams
            (
              get(/databases/$(database)/documents/courses/$(courseId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'teamId', 'teamName', 'updatedAt'
              ])
            )
          );

        allow delete: if isAdmin() || isVerifiedUser() &&
          isValidId(courseId) &&
          isValidId(playerId) &&
          existing().uid == request.auth.uid;
      }
    }
  }
}
